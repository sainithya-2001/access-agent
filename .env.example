# Which backend the agent uses by default: "meta" or "baseten"
LLM_BACKEND=meta

# Meta Model API
MODEL_API_KEY=your_meta_model_api_key_here
MODEL_API_BASE=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.1

# Baseten (Muse Spark Open, open weights) - fill in once credits arrive
BASETEN_API_KEY=
BASETEN_API_BASE=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
